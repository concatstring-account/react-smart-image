{
  "name": "@concatstring/react-smart-image",
  "version": "2.1.2",
  "description": "A drop-in React <img> replacement with lazy loading, WebP, blur/LQIP placeholders, skeleton loaders, responsive srcSet, priority/LCP preloading, aspect-ratio to prevent layout shift (CLS), click-to-zoom lightbox & magnifier, and retry logic — zero dependencies, TypeScript-first.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concatstring-account/react-smart-image.git"
  },
  "bugs": {
    "url": "https://github.com/concatstring-account/react-smart-image/issues"
  },
  "homepage": "https://labs.concatstring.com/products/react-smart-image",
  "main": "dist/react-smart-image.umd.js",
  "module": "dist/react-smart-image.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-smart-image.es.js",
      "require": "./dist/react-smart-image.umd.js"
    }
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "happy-dom": "^20.10.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitest": "^4.1.9"
  },
  "keywords": [
    "react",
    "react-image",
    "react-image-component",
    "react-image-optimization",
    "react-image-performance",
    "image",
    "image-optimization",
    "image-performance",
    "image-optimizer",
    "react-image-optimizer",
    "lazy-loading",
    "lazy-load",
    "lazy-load-image",
    "react-lazy-image",
    "react-image-lazy-loading",
    "intersection-observer",
    "responsive-images",
    "responsive-image",
    "react-responsive-image",
    "react-responsive-images",
    "srcset",
    "progressive-image",
    "progressive-loading",
    "webp",
    "avif",
    "react-image-webp",
    "react-image-avif",
    "image-loader",
    "react-image-loader",
    "image-preloader",
    "react-image-preloader",
    "image-placeholder",
    "react-image-placeholder",
    "blur-placeholder",
    "lqip",
    "skeleton-loader",
    "skeleton-image",
    "shimmer",
    "web-vitals",
    "core-web-vitals",
    "lcp",
    "cls",
    "layout-shift",
    "aspect-ratio",
    "object-fit",
    "image-prefetch",
    "react-image-prefetch",
    "priority-image",
    "priority-loading",
    "image-zoom",
    "react-image-zoom",
    "click-to-zoom",
    "image-lightbox",
    "react-lightbox",
    "image-magnifier",
    "react-image-magnifier",
    "zoom-magnifier",
    "image-fallback",
    "react-image-fallback",
    "image-retry",
    "react-image-retry",
    "download-progress",
    "image-progress",
    "image-progress-bar",
    "react-component",
    "typescript",
    "next-image-alternative",
    "next-image",
    "react-vite-image"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
